# Django Configuration
SECRET_KEY=your-secret-key-here
DEBUG=False
ALLOWED_HOSTS=127.0.0.1,localhost,.onrender.com

# Database Configuration
DATABASE_URL=sqlite:///db.sqlite3
# For production: DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME

# Time Zone
TIME_ZONE=America/Sao_Paulo

# Superuser for bootstrap command (ClienteUser usa email como identificador, sem username)
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=change-me

# Notificações por E-mail (Resend — API HTTP, compatível com Render free tier)
# 1. Crie conta em resend.com (free: 3.000 e-mails/mês)
# 2. Gere uma API Key em resend.com/api-keys
# 3. Adicione e verifique seu domínio em resend.com/domains
#    (ou use "onboarding@resend.dev" para testes iniciais)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
DEFAULT_FROM_EMAIL=Barbearia <noreply@seudominio.com>
BARBEARIA_NOME=Minha Barbearia

# Feature 02: Confirmação de agendamento por link
# URL base usada para montar links nos e-mails enviados pelo management command
SITE_URL=http://127.0.0.1:8000
# Intervalos de envio de lembrete em dias antes do agendamento (separados por vírgula)
LEMBRETE_DIAS_ANTECEDENCIA=3,1,0
