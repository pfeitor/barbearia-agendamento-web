# Django Configuration
SECRET_KEY=your-secret-key-here
DEBUG=False
ALLOWED_HOSTS=127.0.0.1,localhost,.onrender.com

# Database Configuration
DATABASE_URL=sqlite:///db.sqlite3
# For production: DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME

# Time Zone
TIME_ZONE=America/Sao_Paulo

# Superuser for bootstrap command (ClienteUser usa email como identificador, sem username)
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=change-me

# E-mail transacional
# Valores aceitos: smtp ou brevo
EMAIL_PROVIDER=brevo
DEFAULT_FROM_EMAIL=Minha Barbearia <noreply@seudominio.com>
BARBEARIA_NOME=Minha Barbearia

# SMTP (usado quando EMAIL_PROVIDER=smtp)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_USE_SSL=True
SMTP_EMAIL_HOST_USER=seuemail@gmail.com
SMTP_EMAIL_HOST_PASSWORD=app-password

# Brevo API transacional (usado quando EMAIL_PROVIDER=brevo)
API_KEY_BREVO=xkeysib-placeholder
BREVO_SENDER_NAME=Minha Barbearia
BREVO_SENDER_EMAIL=noreply@seudominio.com
BREVO_TIMEOUT=10

# Feature 02: Confirmacao de agendamento por link
# URL base usada para montar links nos e-mails enviados pelo management command
SITE_URL=http://127.0.0.1:8000
# Intervalos de envio de lembrete em dias antes do agendamento (separados por virgula)
LEMBRETE_DIAS_ANTECEDENCIA=3,1,0
